# CenoBots Open API v1.0.16
CENOBOTS_HOST=https://app-server-eu.cz-robots.com
CENOBOTS_ACCESS_KEY=replace_with_access_key
CENOBOTS_SECRET_KEY=replace_with_secret_key
CENOBOTS_ROBOT_OPEN_ID=replace_with_device_open_id
# Optional comma-separated fallback when several device IDs are known.
# CENOBOTS_ROBOT_OPEN_IDS=device_open_id_1,device_open_id_2
CENOBOTS_MIN_REQUEST_INTERVAL_SECONDS=1.05
# CENOBOTS_RESOURCE_SYNC=false
# Robot control remains blocked unless explicitly enabled for a live command.
CENOBOTS_COMMANDS_ENABLED=false
