# Load this file with: set -a; source .env; set +a

AUTH_SESSION_TTL_SECONDS=28800
DEFAULT_ACCOUNT_PASSWORD=efrobotics
ALTEGRO_PERSISTENCE=true
ALTEGRO_PERSISTENCE_DRIVER=postgres
ALTEGRO_SYNC_MODE=async
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=altegro
PGUSER=altegro
# PGPASSWORD_FILE=/run/secrets/altegro_postgres_password
PGPOOL_MAX=10

# S3-compatible attachment storage (AWS S3, MinIO, or equivalent).
OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=eu-central-1
OBJECT_STORAGE_BUCKET=altegro-attachments
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_CREATE_BUCKET=true
# OBJECT_STORAGE_ACCESS_KEY_FILE=/run/secrets/altegro_object_access_key
# OBJECT_STORAGE_SECRET_KEY_FILE=/run/secrets/altegro_object_secret_key
SYNC_JOB_POLL_INTERVAL_MS=1000
SYNC_JOB_STALE_SECONDS=900
EMAIL_JOB_STALE_SECONDS=300
BIND_HOST=127.0.0.1
PORT=3000

# Enable only when the public site is served through HTTPS.
COOKIE_SECURE=false

# Enforce mounted secret files for every enabled live provider in production.
ALTEGRO_REQUIRE_MANAGED_SECRETS=false
# Protect /metrics when it is reachable outside a private monitoring network.
# METRICS_TOKEN_FILE=/run/secrets/altegro_metrics_token

# Email alerts. Disabled until a real SMTP relay and recipients are configured.
EMAIL_ALERTS_ENABLED=false
EMAIL_ALERT_TRANSPORT=smtp
EMAIL_ALERT_FROM=altegro-alerts@example.com
EMAIL_ALERT_RECIPIENTS=operations@example.com
EMAIL_ALERT_MIN_SEVERITY=error
EMAIL_ALERT_COOLDOWN_MINUTES=60
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USERNAME=altegro-alerts@example.com
# EMAIL_SMTP_PASSWORD_FILE=/run/secrets/altegro_smtp_password
# ALTEGRO_PUBLIC_URL=https://altegro.example.com

# AutoXing bridge Python interpreter:
PYTHON_BIN=/mnt/c/Users/meldo/Downloads/autoxing/.venv/bin/python
AUTOXING_LIVE=false
AUTOXING_POLL_INTERVAL_MS=300000
AUTOXING_TASK_SYNC=true
AUTOXING_TASK_DETAIL_LIMIT=25

# Production secret-file mounts (Docker/Kubernetes/systemd credentials).
# Direct APPID/APPSECRET/APPCODE variables still work for local development.
# APPID_FILE=/run/secrets/autoxing_app_id
# APPSECRET_FILE=/run/secrets/autoxing_app_secret
# APPCODE_FILE=/run/secrets/autoxing_app_code

# CenoBots read-only Open API. Select the region assigned to the API key.
CENOBOTS_LIVE=false
CENOBOTS_POLL_INTERVAL_MS=300000
CENOBOTS_HOST=https://app-server-eu.cz-robots.com
CENOBOTS_ACCESS_KEY=replace_with_access_key
CENOBOTS_SECRET_KEY=replace_with_secret_key
CENOBOTS_ROBOT_OPEN_ID=replace_with_device_open_id
# Optional comma-separated fallback when several device IDs are known.
# CENOBOTS_ROBOT_OPEN_IDS=device_open_id_1,device_open_id_2
# Provider requires less than one request per second.
CENOBOTS_MIN_REQUEST_INTERVAL_SECONDS=1.05
# Optional resource collection; disabled for the normal telemetry snapshot.
CENOBOTS_RESOURCE_SYNC=false
# The separate task wrapper is preview-only while this remains false.
CENOBOTS_COMMANDS_ENABLED=false
# Maximum time for an explicitly confirmed live command bridge call.
CENOBOTS_COMMAND_TIMEOUT_MS=60000
# CENOBOTS_MISSION_SYNC=true
# CENOBOTS_MAINTENANCE_HISTORY_LIMIT=10
# CENOBOTS_ACCESS_KEY_FILE=/run/secrets/cenobots_access_key
# CENOBOTS_SECRET_KEY_FILE=/run/secrets/cenobots_secret_key
# Encrypted CenoBots webhooks use a separate subscription secret.
# Public callback: https://your-domain.example/api/v1/webhooks/cenobots
CENOBOTS_WEBHOOK_SECRET=
# CENOBOTS_WEBHOOK_SECRET_FILE=/run/secrets/cenobots_webhook_secret
CENOBOTS_WEBHOOK_FRESHNESS_SECONDS=300
